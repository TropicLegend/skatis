# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# PostgreSQL connection string
DATABASE_URL="postgresql://skatis:skatis@localhost:5432/skatis?schema=public"

# Secret used to sign session tokens. MUST be at least 32 characters – and not
# this placeholder: the API refuses to start with it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-random-secret-of-at-least-32-characters"
# Lifetime of issued session tokens (zeit/ms syntax, e.g. 30m, 12h, 7d)
JWT_EXPIRES_IN=12h

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma separated list of allowed browser origins, or "*" for any origin.
# Set it to the origin of your frontend in production, e.g. https://skatis.online
CORS_ORIGIN=*

# Rate limit for the endpoints that need no token (createTournament, loginTournament).
# RATE_LIMIT_MAX is the number of requests per RATE_LIMIT_WINDOW_MS per caller
# address; set it to 0 to disable the limit.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Wrong passwords per RATE_LIMIT_WINDOW_MS for one tournament, no matter which
# address they come from; set it to 0 to disable the limit.
LOGIN_FAILURE_MAX=100

# Which proxies in front of the API may report the address of a caller
# (X-Forwarded-For). The rate limit counts per address, so this has to cover every
# proxy on the way – a proxy that is missing here makes all callers share one limit.
# The default knows the usual chain: Cloudflare in front, a reverse proxy on the
# same host or in the 192.168.* network.
#   loopback, 192.168.0.0/16, cloudflare   the default
#   false                                  no proxy, callers connect directly
#   1, 2, …                                that many proxies, whatever their addresses
#   loopback, 172.16.0.0/12, cloudflare    a list of your own – it replaces the default
# Names: loopback, linklocal, uniquelocal (10/8, 172.16/12, 192.168/16) and
# cloudflare (the ranges of https://www.cloudflare.com/ips/).
TRUST_PROXY="loopback, 192.168.0.0/16, cloudflare"

# Apply pending migrations on startup (prisma migrate deploy). Set it to false
# when migrations are applied elsewhere, for example by a deployment job.
AUTO_MIGRATE=true

# Timezone used to determine the current matchday (IANA name)
TZ=Europe/Berlin
