// Skatis backend – data model
//
// A tournament is identified by a short public `id` and is protected by two
// passwords:
//   * adminPasswordHash – may change matchdays, reset the regular password and
//     modify or delete lists at any time (including the past)
//   * passwordHash      – may create a list for the current matchday, enter
//     games and submit that list

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Status of a list ("Liste"). Members can no longer change a submitted list,
/// admins can – and they may hand it back to the members via "reopen".
enum ListStatus {
  OPEN
  SUBMITTED
}

/// A tournament. `id` is the public identifier – shown in the frontend after
/// creation and required to log in.
model Tournament {
  /// Short, human friendly code generated by the API, e.g. "K7M2P4QX".
  id                String     @id @db.VarChar(12)
  /// Display name, not unique – tournaments are identified by `id`.
  name              String     @db.VarChar(64)
  /// ISO-8601 weekday numbers (1 = Monday … 7 = Sunday) on which lists may be created
  matchdays         Int[]
  adminPasswordHash String
  passwordHash      String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lists             GameList[]
  players           Player[]

  @@index([name])
  @@map("tournaments")
}

/// A person taking part in a tournament. Players are created once per
/// tournament and can then be put on its lists.
model Player {
  id           String           @id @default(uuid())
  tournamentId String
  name         String           @db.VarChar(64)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  lineups      GameListPlayer[]

  /// Within a tournament a name identifies a player.
  @@unique([tournamentId, name])
  @@map("players")
}

/// One list per matchday of a tournament.
model GameList {
  id           String           @id @default(uuid())
  tournamentId String
  matchday     DateTime         @db.Date
  /// Serie within the tournament – the head of the sheet calls it "Serie".
  series       Int
  /// Tisch of the evening – the number of the table this sheet belongs to.
  table        Int              @map("table_number")
  status       ListStatus       @default(OPEN)
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  tournament   Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  games        Game[]
  /// The players of the table in their seating order (3, 4 or 5 players).
  lineup       GameListPlayer[]

  // A table of a series is unique per evening – two sheets cannot claim the same
  // "Serie 1, Tisch 3". Several lists still share a matchday, they only have to
  // differ in series or table. The list itself is addressed by its id.
  @@unique([tournamentId, matchday, series, table], map: "game_lists_matchday_series_table_key")
  @@index([tournamentId, matchday])
  @@map("game_lists")
}

/// A player on a list. `position` is the seating order of the matchday: the
/// player at position 1 deals in round 1, then position 2 and so on – after the
/// last player the first one deals again.
model GameListPlayer {
  listId   String
  playerId String
  position Int
  list     GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([listId, playerId])
  @@unique([listId, position])
  @@index([playerId])
  @@map("game_list_players")
}

/// The six game types of a game ("Spiel").
enum GameType {
  KARO
  HERZ
  PIK
  KREUZ
  GRAND
  NULL
}

/// "Mit" / "Ohne" – the Spitzen of a suit or grand game.
enum Matadors {
  WITH
  WITHOUT
}

/// A single game ("Spiel") entered into a list.
model Game {
  id       String    @id @default(uuid())
  listId   String
  /// Round within the list, starts at 1.
  position Int
  /// The lineup of the list at the time the game was entered.
  players  String[]
  /// Geber of the round – follows the seating order of the lineup.
  dealer   String
  /// Alleinspieler; `null` means the game was passed out ("eingepasst").
  declarer String?
  gameType GameType?

  /// Gewinnstufen (step 2): announced Hand / Schneider / Schwarz / Offen.
  hand               Boolean @default(false)
  schneiderAnnounced Boolean @default(false)
  schwarzAnnounced   Boolean @default(false)
  offen              Boolean @default(false)

  /// Spitzen (step 3) – never set for a null game.
  matadors      Matadors?
  matadorsCount Int?

  /// Spielergebnis (step 4).
  schneider Boolean  @default(false)
  schwarz   Boolean  @default(false)
  won       Boolean?

  /// Spielwert, computed by the API from the properties above.
  gameValue Int @default(0)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  list      GameList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, position])
  @@map("games")
}
