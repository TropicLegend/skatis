// Skatis backend – data model
//
// A tournament is identified by a short public `id` and is protected by two
// passwords:
//   * adminPasswordHash – may change matchdays, reset the regular password and
//     modify or delete lists at any time (including the past)
//   * passwordHash      – may create a list for the current matchday, enter
//     games and submit that list

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Status of a list ("Liste"). Members can no longer change a submitted list,
/// admins can – and they may hand it back to the members via "reopen".
enum ListStatus {
  OPEN
  SUBMITTED
}

/// A tournament. `id` is the public identifier – shown in the frontend after
/// creation and required to log in.
model Tournament {
  /// Short, human friendly code generated by the API, e.g. "K7M2P4QX".
  id                String     @id @db.VarChar(12)
  /// Display name, not unique – tournaments are identified by `id`.
  name              String     @db.VarChar(64)
  /// ISO-8601 weekday numbers (1 = Monday … 7 = Sunday) on which lists may be created
  matchdays         Int[]
  adminPasswordHash String
  passwordHash      String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lists             GameList[]

  @@index([name])
  @@map("tournaments")
}

/// One list per matchday of a tournament.
model GameList {
  id           String     @id @default(uuid())
  tournamentId String
  matchday     DateTime   @db.Date
  status       ListStatus @default(OPEN)
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  games        Game[]

  @@unique([tournamentId, matchday])
  @@map("game_lists")
}

/// A single game ("Spiel") entered into a list.
model Game {
  id        String   @id @default(uuid())
  listId    String
  position  Int
  players   String[]
  declarer  String?
  gameType  String?
  points    Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  list      GameList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, position])
  @@map("games")
}
